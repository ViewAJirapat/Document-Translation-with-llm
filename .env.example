# Copy to .env and edit. docker compose reads .env automatically.

# Where llama-server runs.
#   Same PC as Docker Desktop:  http://host.docker.internal:8080
#   Another PC on your network: http://192.168.1.50:8080
LLAMA_URL=http://host.docker.internal:8080

# Must match llama-server's --api-key. Leave empty if the server has no key.
LLAMA_API_KEY=

# Font written into exported DOCX files (must be installed on the PC that opens the file).
# "TH Sarabun New" with size 16 is the usual choice for Thai official/academic documents.
DOCX_FONT=Leelawadee UI
DOCX_FONT_SIZE=11
